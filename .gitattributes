# Auto detect text files and perform LF normalization
* text=auto

# Git LFS for binary game assets under the Unity project only.
# docs/qa screenshots stay in plain git (small QA evidence).

# Images
Client/Assets/**/*.png filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.tga filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.tif filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.tiff filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.bmp filter=lfs diff=lfs merge=lfs -text
Client/Assets/**/*.gif filter=lfs diff=lfs merge=lfs -text

