using Xunit;
using Xunit.Abstractions;

namespace PingTheKiller.Tests.Core;

// U2d balance targets (docs/briefs/U2d-a1.md 짠3), measured on 40 fixed private seeds per configuration with the
// all-bot hook (no human) or an idle human killer. Filter the long sweeps out with --filter "Category!=BalanceSweep".
public sealed class BotBalanceTests
{
    private readonly ITestOutputHelper _output;
    public BotBalanceTests(ITestOutputHelper output) { _output = output; }

    internal const int Seeds = 40;

    public static IEnumerable<object[]> Configs() => new[]
    {
        // config, survivors (0 = idle human killer + 7 bots), win min/max, median min/max seconds, max timeout share.
        // GDD v2 (U6a): the U2d win and length bands are reported only until U6d sets the v2 targets; the gate is that 1v7
        // all-bot matches end through the rules (at most 30 % time-ups).
        new object[] { "1v7", 7, 0.35, 0.65, 540.0, 660.0, 0.10 },
        new object[] { "1v3", 3, 0.25, 0.75, 0.0, 660.0, 0.20 },
        new object[] { "1v1", 1, 0.15, 0.85, 0.0, 900.0, 0.30 },
        new object[] { "idle killer + 7", 0, 0.90, 1.0, 0.0, 900.0, 0.0 },
    };

    [Theory]
    [Trait("Category", "BalanceSweep")]
    [MemberData(nameof(Configs))]
    public void BalanceSweepMeetsTheTargets(string config, int survivors, double winMin, double winMax,
        double medianMin, double medianMax, double timeoutMax)
    {
        var watch = System.Diagnostics.Stopwatch.StartNew();
        var runs = BotBalance.Sweep(Enumerable.Range(1, Seeds),
            seed => survivors == 0 ? BotBalance.RunIdleKiller(seed) : BotBalance.RunAllBots(seed, survivors));
        var summary = BotBalance.Summarize(runs);
        foreach (var run in runs) _output.WriteLine(BotBalance.Detail(run));
        _output.WriteLine(BotBalance.Header);
        _output.WriteLine(summary.Row(config));
        _output.WriteLine($"lagging timeouts per match {summary.LagTimeouts:0.00}; sweep {watch.Elapsed.TotalSeconds:0.0} s");
        _output.WriteLine($"U2d bands (not gated under GDD v2): win {winMin:P0}-{winMax:P0}, median {medianMin:0}-{medianMax:0} s");
        Assert.Equal(Seeds, summary.Matches);
        Assert.InRange(summary.WinRate, winMin, winMax);
        Assert.InRange(summary.Median, medianMin, medianMax);
        Assert.True(summary.TimeoutRate <= timeoutMax, $"timeouts {summary.TimeoutRate:P0}");
    }

    // The all-bot hook is deterministic per private seed: the same seed replays the same match.
    [Fact]
    public void AllBotMatchesAreDeterministicPerPrivateSeed()
    {
        foreach (int seed in new[] { 3, 17 })
        {
            var a = BotBalance.Detail(BotBalance.RunAllBots(seed, 7));
            var b = BotBalance.Detail(BotBalance.RunAllBots(seed, 7));
            _output.WriteLine(a);
            Assert.Equal(a, b);
        }
    }
}

                Assert.True(run.Completed >= 1, $"seed {seed}: time-out without any terminal");
            }
        }
        double median = Median(lengths);
        _output.WriteLine($"median {median:0.0}s, time-outs with a Normal bot {botTimeouts}");
        // U6a gate under GDD v2: at most 6 of 15 time-ups (raised from 4 by the orchestrator in U6a attempt 2: without
        // Lagging executions survivors live longer and more matches reach the limit). U6d sets the tuned v2 targets.
        // Raised to 7 by the orchestrator at the 2026-11-04 merge (map v2.1 + rules v2): seeds 2, 3, 5, 15 time out with the
        // killer bot moving and survivor bots hacking ~3-9 s per 30 s across many terminals (bot pacing, not a stall). U6d
        // must restore <= 4 (docs/qa/merge-1104/botfreeze-impl.md).
        Assert.True(botTimeouts <= 4, $"time-outs with a Normal bot {botTimeouts} of 15");
        Assert.True(median >= floor, $"median match length {median:0.0}s");
        // GDD v2: the U2d 360 s ceiling no longer applies (45 s terminals, 15 s switch); U6d sets the v2 length targets.
        if (humanRole == RoleChoice.Killer) Assert.True(median <= GameConstants.MatchLengthSeconds, $"median match length {median:0.0}s");
    }

    // Seeded reproduction of the 3/4 stall (killer-bot mode, private seeds 3 and 5 before U2c): survivor bots were
    // pinned at x = 20.4 and x = 17.6 against the wall (18,14)-(20,32) because straight-line steering with random
    // sidesteps cannot leave a wall whose span contains the target coordinate; in seed 5 a ThreatLevel 2 freeze with
    // the killer bot stuck on the other side of the same wall never released.
        double bestGated = Enumerable.Range(0, 7).Max(f => Math.Max(aucs[f], 1 - aucs[f]));
        _out.WriteLine($"best single gated feature AUC {bestGated:0.000}");
