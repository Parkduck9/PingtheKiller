diff --git a/Server.Tests/Core/BotV2Tests.cs b/Server.Tests/Core/BotV2Tests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3f5fefa4b290cf484935a6f5454258b2520caf3a
--- /dev/null
+++ b/Server.Tests/Core/BotV2Tests.cs
@@ -0,0 +1,84 @@
+using System.Reflection;
+using PingTheKiller.ServerCore;
+using PingTheKiller.ServerCore.Map;
+using PingTheKiller.Shared.Game;
+using PingTheKiller.Shared.Packets;
+using Xunit;
+using Xunit.Abstractions;
+
+namespace PingTheKiller.Tests.Core;
+
+public sealed class BotV2Tests
+{
+    private readonly ITestOutputHelper _output;
+    public BotV2Tests(ITestOutputHelper output) => _output = output;
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void UnseenCampResumesWork(bool visible)
+    {
+        var map = new FixedMap();
+        var nav = new NavGrid(map);
+        var brain = new SurvivorBrain();
+        var rng = new Random(1);
+        var view = new SurvivorBotView { SelfId = 1, X = 41, Z = 38, Speed = 4, Status = PlayerStatus.Normal };
+        view.Terminals = map.CreateTerminals(1, out _);
+        view.TerminalCount = view.Terminals.Length;
+        for (int i = 0; i < view.TerminalCount; i++) if (i != 4) view.Terminals[i].Progress = 100;
+        int hacked = 0;
+        for (int tick = 1; tick <= 3600; tick++)
+        {
+            view.Time = tick * .05;
+            view.KillerVisible = visible;
+            view.KillerX = 34; view.KillerZ = 43.5f;
+            view.Threat = GameServer.ThreatForDistance(MathF.Sqrt((view.X - 34) * (view.X - 34) + (view.Z - 43.5f) * (view.Z - 43.5f)));
+            var intent = brain.Update(view, nav, map, rng);
+            var point = map.Move(view.X, view.Z, intent.DirX * .2f, intent.DirZ * .2f);
+            view.X = point.X; view.Z = point.Z;
+            view.Team.Clear();
+            view.Team.Add(new PlayerState { Id = 1, X = view.X, Z = view.Z, Flags = (byte)(intent.Interact || intent.DirX != 0 || intent.DirZ != 0 ? PlayerFlags.Signal : PlayerFlags.None) });
+            if (intent.Interact) hacked++;
+            if (tick % 200 == 0) _output.WriteLine($"{view.Time} pos {view.X},{view.Z} threat {view.Threat} mode {Field(brain, "_mode")} goal {Field(brain, "_goalX")},{Field(brain, "_goalZ")} calm {Field(brain, "_calmUntil")} term {Field(brain, "_terminal")}");
+        }
+        Assert.True(hacked > 400, $"hacked {hacked}");
+    }
+
+    private static object? Field(object brain, string name) => brain.GetType().GetField(name, BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(brain);
+
+    [Fact]
+    public void TraceSingleSurvivor()
+    {
+        using var server = new GameServer(new ServerOptions { IsOffline = true, Seed = 1, BotCount = 2, AutoStart = true });
+        server.Log += s => { if (s.StartsWith("terminal ") || s.StartsWith("status ") || s.StartsWith("kick ") || s.StartsWith("match end")) _output.WriteLine(s); };
+        for (int tick = 0; tick < 18001; tick++)
+        {
+            server.Tick(.05f);
+            if (tick % 600 == 0)
+                _output.WriteLine($"{tick/20}s " + string.Join("; ", server.PlayerSnapshot().Select(p => $"{p.Role} {p.Status} {p.X:0.0},{p.Z:0.0} hack {p.Hacking}")));
+        }
+    }
+
+    [Fact]
+    public void TraceIdleKiller()
+    {
+        using var f = new CoreFixture(seed: 14);
+        var human = f.Join("idle");
+        human.Send(new C2S_SetBots { Count = 7 });
+        human.Send(new C2S_SetRole { RoleChoice = (byte)RoleChoice.Killer });
+        human.Send(new C2S_StartMatch());
+        for (int tick = 0; tick < 18001; tick++)
+        {
+            f.Tick(); human.Drain(); human.Packets.Clear();
+            if (tick % 2400 != 0) continue;
+            _output.WriteLine($"{tick / 20}s");
+            var brains = (System.Collections.IDictionary)typeof(GameServer).GetField("_brains", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(f.Server)!;
+            foreach (System.Collections.DictionaryEntry pair in brains)
+            {
+                var p = (Player)pair.Key;
+                var brain = pair.Value!;
+                _output.WriteLine($"{p.Id} {p.X:0.0},{p.Z:0.0} mode {Field(brain, "_mode")} term {Field(brain, "_terminal")} goal {Field(brain, "_goalX")},{Field(brain, "_goalZ")} hold {Field(brain, "_calmUntil")} seen {Field(brain, "_killerSeenAt")}");
+            }
+        }
+    }
+}
