                    // arrived before this tick started has been handled already, so fail only once that start is past it.
                    double limit = player.SyncSentAt + GameConstants.SyncCheckDurationSeconds + GameConstants.SyncToleranceSeconds +
                        RttOf(player);
                    if (_tickSimStart + _tickLag >= limit - TimeEpsilon) Resolve(player, SyncResult.Fail);
                    continue;
                }
                if (!player.Hacking || !SyncChecksEnabled) continue;
                player.SyncTimer -= dt;
                if (player.SyncTimer <= TimeEpsilon) IssueSyncCheck(player);
            }
        }

        private void IssueSyncCheck(Player player)
        {
            var random = player.SyncRandom;
            player.SyncPending = true;
            player.SyncCheckId = ++_nextCheckId;
            player.SyncTerminal = player.HackTerminal;
            // The moment the check leaves (this tick's start plus the time spent in it), not the end of the tick.
            player.SyncSentAt = SimulatedNow();
            player.SyncZoneStart = (float)(GameConstants.SyncZoneStartMin +
                random.NextDouble() * (GameConstants.SyncZoneStartMax - GameConstants.SyncZoneStartMin));
            player.SyncBotPressAt = double.NaN;
            if (player.IsBot && random.NextDouble() < player.BotSyncSuccessRate)
            {
                // A bot hit lands in the middle of the great part or of the rest of the zone; a miss never presses.
                double fraction = random.NextDouble() < BotSyncGreatShare
                    ? player.SyncZoneStart + GameConstants.SyncGreatSize / 2.0
                    : player.SyncZoneStart + (GameConstants.SyncGreatSize + GameConstants.SyncZoneSize) / 2.0;
                player.SyncBotPressAt = player.SyncSentAt + fraction * GameConstants.SyncCheckDurationSeconds;
            }
            SendTo(player, new S2C_SyncCheck
            {
                CheckId = player.SyncCheckId, TerminalId = _terminals[player.SyncTerminal].Id,
                Duration = GameConstants.SyncCheckDurationSeconds, ZoneStart = player.SyncZoneStart,
                ZoneSize = GameConstants.SyncZoneSize, GreatSize = GameConstants.SyncGreatSize
            });
        }

        // C2S_SyncPress: unknown, expired, repeated or non-survivor presses are ignored without a reply.
        // receivedAt: server clock when the press was queued, so the wait for the next tick does not count.
        private void SyncPress(Player player, uint checkId, double receivedAt)
        {
            if (player.Role != Role.Survivor || !player.SyncPending || player.SyncCheckId != checkId || player.IsBot) return;
            // The needle the player saw had run (arrival - sent - rtt) seconds.
            Judge(player, SimulatedArrival(receivedAt) - RttOf(player));
        }

        // Classifies a press moment against the pending check of this survivor.
        private void Judge(Player player, double pressAt) =>
            Resolve(player, Classify((pressAt - player.SyncSentAt) / GameConstants.SyncCheckDurationSeconds, player.SyncZoneStart));

        // Fraction of the sweep at the press. The tolerance widens both zone edges; a press inside the leading tolerance
        // band counts as Good, only the great part itself counts as Great.
        internal static SyncResult Classify(double fraction, float zoneStart)
        {
            const double edge = 0.000001;
            double tolerance = GameConstants.SyncToleranceSeconds / GameConstants.SyncCheckDurationSeconds;
            if (fraction >= zoneStart - edge && fraction <= zoneStart + GameConstants.SyncGreatSize + edge) return SyncResult.Great;
            if (fraction >= zoneStart - tolerance - edge && fraction <= zoneStart + GameConstants.SyncZoneSize + tolerance + edge)
                return SyncResult.Good;
            return SyncResult.Fail;
        }

        private void Resolve(Player player, SyncResult result)
        {
            int terminal = player.SyncTerminal;
            uint id = player.SyncCheckId;
            player.SyncPending = false;
            player.SyncBotPressAt = double.NaN;
            player.SyncTimer = NextSyncInterval(player);
            if (terminal >= 0 && terminal < _terminals.Length && !TerminalDone(terminal))
            {
                if (result == SyncResult.Great) _progress[terminal] += GameConstants.SyncGreatBonusPoints;
                else if (result == SyncResult.Fail)
                {
                    _progress[terminal] = Math.Max(0, _progress[terminal] - GameConstants.SyncFailPenaltyPoints);
                    _overloadedUntil[terminal] = _now + GameConstants.OverloadedSeconds;
                }
                SyncTerminal(terminal);
            }
            WriteLog($"sync player={player.Id} check={id} result={result}");
            SendTo(player, new S2C_SyncResult { CheckId = id, Result = (byte)result });
        }


        // GDD v2 짠3: the hatch opens once, when exactly one of at least two starting survivors is still in play.
        private void UpdateHatch()
        {
            if (_hatchSpawned || _startingSurvivors < 2) return;
            int active = 0;
            foreach (var player in _players) if (player.IsActiveSurvivor) ++active;
            if (active != 1) return;
            var point = Map.HatchPoints[_random.Next(Map.HatchPoints.Count)];
            _hatchSpawned = _hatchOpen = true;
            _hatchX = point.X;
            _hatchZ = point.Z;
            WriteLog($"hatch open x={_hatchX} z={_hatchZ}");
        }

        // The killer closed the hatch: both exits get power and the collapse starts unless it already runs.
        private void CloseHatch()
        {
            _hatchOpen = false;
            WriteLog("hatch closed");
            PowerExits("hatch");
            StartCollapse("hatch");
        }

        // Only within HatchSightDistance and with a wall-free line, so neither side learns the hatch for free.
        private bool HatchVisibleTo(Player player) =>
            _hatchOpen && DistanceSquared(player.X, player.Z, _hatchX, _hatchZ) <=
                GameConstants.HatchSightDistance * GameConstants.HatchSightDistance + 0.000001f &&
            !Map.SegmentBlocked(player.X, player.Z, _hatchX, _hatchZ);

        // Firewall Block target: the unopened exit with the highest switch progress above 0, or -1.
        private int FirewallTarget()
        {
            int target = -1;
            double best = TimeEpsilon;
            for (int i = 0; i < _exitOpen.Length; i++)
                if (!_exitOpen[i] && _switchSeconds[i] > best) { best = _switchSeconds[i]; target = i; }
            return target;
        }

        private byte SwitchPercent(int exit) => _exitOpen[exit] ? (byte)100
            : (byte)Math.Min(99, Math.Floor(_switchSeconds[exit] * 100 / GameConstants.ExitSwitchSeconds + TimeEpsilon));

        private void AddExitStates(List<ExitState> exits)
        {
            for (int i = 0; i < _exitOpen.Length; i++)
            {
                var flags = ExitFlags.None;
                if (_powered) flags |= ExitFlags.Powered;
                if (_exitOpen[i]) flags |= ExitFlags.Open;
                else if (ExitLocked(i)) flags |= ExitFlags.Locked;
                exits.Add(new ExitState
                {
                    Id = (byte)i, X = Map.Exits[i].X, Z = Map.Exits[i].Z, Flags = (byte)flags, SwitchProgress = SwitchPercent(i)
                });
            }
        }

        // Server tests only: forces a status between ticks (hatch and collapse scenarios).
        internal void SetStatusForTests(int playerId, PlayerStatus status)
        {
            lock (_tickGate)
                foreach (var player in _players)
                    if (player.Id == playerId) SetStatus(player, status, "test");
        }

        internal (bool Open, float X, float Z) HatchForTests() { lock (_tickGate) return (_hatchOpen, _hatchX, _hatchZ); }
    }
}
using PingTheKiller.Shared.Game;
using PingTheKiller.Shared.Packets;
using Xunit;
using Xunit.Abstractions;

namespace PingTheKiller.Tests.Core;

// Compares what the killer can measure about phantom tracks and real tracks, using the server's ground-truth labels.
// A track is one uninterrupted presence of one label in the killer view (live frames, then afterimage frames).
public sealed class IndistinguishabilityTests
{
    private readonly ITestOutputHelper _output;
    public IndistinguishabilityTests(ITestOutputHelper output) { _output = output; }

    private sealed class Track
    {
        // Excluded real tracks: Lagging (Status shows it), forced exposure (the killer's own Ping Scanner or the
        // Traffic Overload notice explains it), rescuing (a still blip beside a Lagging blip), holding an exit switch (a
        // still blip on a known switch point while its progress rises, GDD v2) and tracks that end because the survivor
        // escaped or was eliminated mid-match (GDD v2: the match goes on). Phantoms do none of these.
        internal bool Phantom, Lagging, Truncated, Excluded;
        internal readonly List<(float X, float Z)> Live = new();
        internal int Tail;
        internal float SpawnNearest;
    }

    private static List<Track> Record(int seed)
    {
        var tracks = new List<Track>();
        using var r = new KillerMatchRecorder(seed, SkillIds.PacketAfterimage);
        var open = new Dictionary<(bool, int), Track>();
        r.Run(packets =>
        {
            var world = packets.OfType<S2C_WorldState>().LastOrDefault();
            if (world == null) return;
            var sources = r.F.Server.KillerViewSources;
            if (sources.Count != world.Players.Count) return; // the final frame: the match has already been reset
            var truth = r.F.Server.PlayerSnapshot();
            var present = new HashSet<(bool, int)>();
            for (int i = 0; i < world.Players.Count; i++)
            {
                var entry = world.Players[i];
                if (entry.Role != (byte)Role.Survivor) continue;
                var key = (sources[i].Phantom, sources[i].Label);
                present.Add(key);
                if (!open.TryGetValue(key, out var track))
                {
                    track = new Track { Phantom = sources[i].Phantom };
                    track.SpawnNearest = truth.Where(p => p.Role == Role.Survivor && (p.Status == PlayerStatus.Normal || p.Status == PlayerStatus.Lagging) &&
                            (sources[i].Phantom || p.Id != sources[i].Label))
                        .Select(p => MathF.Sqrt((p.X - entry.X) * (p.X - entry.X) + (p.Z - entry.Z) * (p.Z - entry.Z)))
                        .DefaultIfEmpty(float.NaN).Min();
                    open[key] = track;
                    tracks.Add(track);
                }
                if (entry.Status == (byte)PlayerStatus.Lagging) track.Lagging = true;
                if (!sources[i].Phantom && truth.FirstOrDefault(p => p.Id == sources[i].Label) is var t && (t.Exposed || t.Rescuing || t.Switching))
                    track.Excluded = true;
                if (sources[i].Afterimage) track.Tail++;
                else { track.Tail = 0; track.Live.Add((entry.X, entry.Z)); }
            }
            foreach (var key in open.Keys.Where(k => !present.Contains(k)).ToList())
            {
                if (!key.Item1 && truth.FirstOrDefault(p => p.Id == key.Item2) is var gone &&
                    (gone.Status == PlayerStatus.Escaped || gone.Status == PlayerStatus.Eliminated))
                    open[key].Excluded = true;
                open.Remove(key);
            }
        });
        foreach (var track in open.Values) track.Truncated = true;
        return tracks;
    }

    // Two-sample Kolmogorov-Smirnov statistic and asymptotic p-value.
    internal static (double d, double p) KolmogorovSmirnov(IReadOnlyList<double> a, IReadOnlyList<double> b)
    {
        var x = a.OrderBy(v => v).ToArray();
        var y = b.OrderBy(v => v).ToArray();
        int i = 0, j = 0;
        double d = 0;
        while (i < x.Length && j < y.Length)
        {
            double v = Math.Min(x[i], y[j]);
            while (i < x.Length && x[i] <= v) i++;
            while (j < y.Length && y[j] <= v) j++;
            d = Math.Max(d, Math.Abs((double)i / x.Length - (double)j / y.Length));
        }
        double en = Math.Sqrt((double)x.Length * y.Length / (x.Length + y.Length));
        double lambda = (en + 0.12 + 0.11 / en) * d;
        double p = 0;
        for (int k = 1; k <= 100; k++) p += 2 * Math.Pow(-1, k - 1) * Math.Exp(-2 * k * k * lambda * lambda);
        return (d, Math.Max(0, Math.Min(1, d == 0 ? 1 : p)));
    }

