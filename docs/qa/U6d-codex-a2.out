using System.Reflection;
using PingTheKiller.ServerCore;
using PingTheKiller.ServerCore.Map;
using PingTheKiller.Shared.Game;
using Xunit;

namespace PingTheKiller.Tests.Core;

// Decisions are exercised with role views and the public static map.
public sealed class BotV2Tests
{
    private readonly FixedMap _map = new();
    private readonly NavGrid _nav;
    public BotV2Tests() => _nav = new NavGrid(_map);
    private static T Read<T>(object brain, string name) =>
        (T)brain.GetType().GetField(name, BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(brain)!;
    private static SurvivorBotView Survivor(int id = 1) => new()
    {
        SelfId = id, X = 41, Z = 42.7f, Speed = 4, Status = PlayerStatus.Normal,
        Terminals = new[] { new TerminalState { X = 41, Z = 44, Progress = 40 },
            new TerminalState { X = 58, Z = 27, Progress = 20 } }, TerminalCount = 2
    };
    private static PlayerState Ally(int id, float x, float z, PlayerStatus status = PlayerStatus.Normal, float timer = 60) =>
        new() { Id = id, X = x, Z = z, Status = (byte)status, StatusTimer = timer, CaptureCount = 1 };
    private BotIntent Step(SurvivorBrain brain, SurvivorBotView view, Random rng)
    {
        view.Time += .05;
        return brain.Update(view, _nav, _map, rng);
    }

    [Fact]
    public void EveryNormalSurvivorWorksAndAtMostTwoHackEachTerminal()
    {
        const int count = 7;
        var brains = Enumerable.Range(0, count).Select(_ => new SurvivorBrain()).ToArray();
        var views = Enumerable.Range(1, count).Select(id => Survivor(id)).ToArray();
        var rngs = Enumerable.Range(1, count).Select(id => new Random(id)).ToArray();
        var worked = new bool[count];
        var intents = new BotIntent[count];
        foreach (var view in views)
        {
            view.Terminals = _map.CreateTerminals(7, out _);
            view.TerminalCount = view.Terminals.Length;
        }
        for (int tick = 0; tick < 2400; tick++)
        {
            foreach (var view in views)
            {
                view.Team.Clear();
                foreach (var other in views) view.Team.Add(Ally(other.SelfId, other.X, other.Z));
            }
            var hackers = new int[views[0].TerminalCount];
            for (int i = 0; i < count; i++)
            {
                intents[i] = Step(brains[i], views[i], rngs[i]);
                if (!intents[i].Interact) continue;
                worked[i] = true;
                int target = Read<int>(brains[i], "_terminal");
                if (target >= 0) hackers[target]++;
            }
            Assert.All(hackers, n => Assert.InRange(n, 0, 2));
            for (int i = 0; i < count; i++)
            {
                var next = _map.Move(views[i].X, views[i].Z, intents[i].DirX * .2f, intents[i].DirZ * .2f);
                views[i].X = next.X; views[i].Z = next.Z;
            }
        }
        Assert.All(worked, value => Assert.True(value));
    }

    [Fact]
    public void TerminalChoicePrefersProgressThenDistanceAndRespectsTwoSlots()
    {
        var view = Survivor(3); var brain = new SurvivorBrain(); var rng = new Random(1);
        view.Team.Add(Ally(1, 41, 43)); view.Team.Add(Ally(2, 42, 44));
        Step(brain, view, rng);
        Assert.Equal(1, Read<int>(brain, "_terminal"));
        view.Team.Clear();
        for (int i = 0; i < 20; i++) Step(brain, view, rng);
        Assert.Equal(0, Read<int>(brain, "_terminal"));
        view.Terminals[1].Progress = 50;
        for (int i = 0; i < 20; i++) Step(brain, view, rng);
        Assert.Equal(1, Read<int>(brain, "_terminal"));
        view.Terminals[1].Progress = 40;
        for (int i = 0; i < 20; i++) Step(brain, view, rng);
        Assert.Equal(0, Read<int>(brain, "_terminal"));
    }

    [Theory]
    [InlineData(true, 0)]
    [InlineData(false, 2)]
    public void SightOrThreatTwoInterruptsHacking(bool visible, byte threat)
    {
        var view = Survivor(); var brain = new SurvivorBrain(); var rng = new Random(2);
        bool hacked = false;
        for (int i = 0; i < 300; i++) hacked |= Step(brain, view, rng).Interact;
        Assert.True(hacked);
        view.KillerVisible = visible; view.KillerX = 34; view.KillerZ = 43.5f; view.Threat = threat;
        for (int i = 0; i < 20; i++) Step(brain, view, rng);
        Assert.False(Step(brain, view, rng).Interact);
        if (visible)
            Assert.True(_map.SegmentBlocked(view.KillerX, view.KillerZ, Read<float>(brain, "_goalX"), Read<float>(brain, "_goalZ")));
    }

    [Theory]
    [InlineData(60, 0, false, true)]
    [InlineData(12, 2, true, true)]
    [InlineData(5, 2, true, false)]
    [InlineData(30, 2, true, false)]
    public void RescueUsesArrivalHoldAndUrgency(float timer, byte threat, bool recentlySeen, bool expected)
    {
        var view = Survivor(); view.Threat = threat;
        view.Team.Add(Ally(2, 45, 43, PlayerStatus.Lagging, timer));
        if (recentlySeen) { view.KillerVisible = true; view.KillerX = 20; view.KillerZ = 20; }
        var brain = new SurvivorBrain(); var rng = new Random(3);
        Step(brain, view, rng);
        if (recentlySeen) view.KillerVisible = false;
        for (int i = 0; i < 15; i++) Step(brain, view, rng);
        bool rescue = Math.Abs(Read<float>(brain, "_goalX") - 45) < .01f && Math.Abs(Read<float>(brain, "_goalZ") - 43) < .01f;
        Assert.Equal(expected, rescue);
    }

    [Fact]
    public void OnlyNearestEligibleNormalSurvivorRescues()
    {
        var view = Survivor(3); view.Team.Add(Ally(2, 45, 43, PlayerStatus.Lagging, 30));
        view.Team.Add(Ally(1, 44, 43));
        var brain = new SurvivorBrain(); var rng = new Random(3);
        for (int i = 0; i < 200; i++) Step(brain, view, rng);
        Assert.NotEqual(45, Read<float>(brain, "_goalX"));
        Assert.True(Step(brain, view, rng).Interact || Read<int>(brain, "_terminal") >= 0);
    }

    [Fact]
    public void NearestNormalHoldsMostAdvancedSwitchAndEveryoneHeadsToOpenExit()
    {
        var view = Survivor(); view.Team.Add(Ally(1, view.X, view.Z)); view.Team.Add(Ally(2, 10, 25));
        view.Exits = new[] { new BotExit { X = 10, Z = 25, SwitchX = 10, SwitchZ = 25, Powered = true, Progress = 20 },
            new BotExit { X = 45, Z = 44, SwitchX = 41, SwitchZ = 43, Powered = true, Progress = 80 } };
        view.ExitCount = 2;
        var brain = new SurvivorBrain(); var rng = new Random(1);
        Assert.True(Step(brain, view, rng).Interact);
        view.Exits[1].Open = true;
        view.KillerVisible = true; view.KillerX = 42; view.KillerZ = 43; view.Threat = 3;
        for (int i = 0; i < 20; i++) Step(brain, view, rng);
        Assert.Equal(45, Read<float>(brain, "_goalX"));
        Assert.Equal(44, Read<float>(brain, "_goalZ"));
        Assert.False(Step(brain, view, rng).Interact);
    }

    [Theory]
    [InlineData(100, true)]
    [InlineData(8, false)]
    public void CollapseAllowsOnlyCloseAffordableRescueBeforeEscape(float collapse, bool rescue)
    {
        var view = Survivor(); view.CollapseLeft = collapse;
        view.Team.Add(Ally(2, 44, 43, PlayerStatus.Lagging, 30));
        view.Exits = new[] { new BotExit { X = 48, Z = 44, Open = true, Powered = true } }; view.ExitCount = 1;
        var brain = new SurvivorBrain(); var rng = new Random(2);
        Step(brain, view, rng);
        Assert.Equal(rescue ? 44 : 48, Read<float>(brain, "_goalX"));
    }

    [Theory]
    [InlineData(SkillIds.TrafficOverload)]
    [InlineData(SkillIds.StealthRelay)]
    public void SurvivorUsesChaseAndHackSkills(byte skill)
    {
        var view = Survivor(); view.Skill = skill; view.SkillReady = true;
        var brain = new SurvivorBrain(); var rng = new Random(1);
        bool used = false;
        for (int i = 0; i < 300; i++)
        {
            if (skill == SkillIds.TrafficOverload) { view.KillerVisible = true; view.KillerX = 43; view.KillerZ = 44; }
            else view.Threat = 1;
            used |= Step(brain, view, rng).UseSkill;
        }
        Assert.True(used);
    }

    private static KillerBotView Killer() => new()
    {
        X = 41, Z = 43, Speed = 4.6f, Yaw = 0,
        Terminals = new[] { new KillerBotView.Terminal { X = 41, Z = 44 }, new KillerBotView.Terminal { X = 58, Z = 27 } }, TerminalCount = 2
    };

    [Fact]
    public void PredictiveAimUsesAnonymousVelocityAndStopsExtrapolatingAfterOnePointFiveSeconds()
    {
        var view = Killer(); var brain = new KillerBrain(); var rng = new Random(1);
        view.TerminalCount = 8; view.Terminals = new KillerBotView.Terminal[8];
        for (int i = 0; i <= 20; i++)
        {
            view.Time = i * .05;
            view.Blips.Clear(); view.Blips.Add(new KillerBotView.Blip { X = 41 + (float)view.Time * 2, Z = 44 });
            brain.Update(view, _nav, _map, rng);
        }
        Assert.InRange(Read<float>(brain, "_velocityX"), 1.99f, 2.01f);
        float observed = Read<float>(brain, "_observedX");
        view.Blips.Clear(); view.Time = 1.4;
        brain.Update(view, _nav, _map, rng);
        Assert.True(Read<float>(brain, "_targetX") > observed);
        view.Time = 3; brain.Update(view, _nav, _map, rng);
        Assert.False(Read<bool>(brain, "_hasTarget"));
        float target = Read<float>(brain, "_targetX");
        view.Time = 3.2; brain.Update(view, _nav, _map, rng);
        Assert.Equal(target, Read<float>(brain, "_targetX"));
    }

    [Fact]
    public void PatrolRanksRecentSignalsThenDistanceAndForgetsThemAfterSixtySeconds()
    {
        var view = Killer(); var brain = new KillerBrain(); var rng = new Random(1);
        view.Blips.Add(new KillerBotView.Blip { X = 58, Z = 27 });
        brain.Update(view, _nav, _map, rng);
        Assert.Equal(1, Read<int>(brain, "_patrol"));
        view.Blips.Clear(); view.Time = 61;
        brain.Update(view, _nav, _map, rng);
        Assert.Equal(0, Read<int>(brain, "_patrol"));
    }

    [Fact]
    public void KillerHoldsKickForTwoSecondsThenLeavesWithoutRevisitingLaggingBlips()
    {
        var view = Killer(); view.X = 41; view.Z = 44;
        var brain = new KillerBrain(); var rng = new Random(1);
        view.Blips.Add(new KillerBotView.Blip { X = 41, Z = 44, Lagging = true });
        int held = 0;
        for (int i = 0; i < 60; i++)
        {
            view.Time = i * .05;
            var intent = brain.Update(view, _nav, _map, rng);
            if (intent.Interact) { held++; Assert.Equal(0, intent.DirX); Assert.Equal(0, intent.DirZ); }
        }
        Assert.InRange(held, 40, 46);
        Assert.False(Read<bool>(brain, "_hasTarget"));
        view.Time = 8; brain.Update(view, _nav, _map, rng);
        Assert.Equal(1, Read<int>(brain, "_patrol"));
    }

    [Fact]
    public void KillerGuardsMostAdvancedPoweredExit()
    {
        var view = Killer();
        view.Exits = new[] { new BotExit { Powered = true, Progress = 10, SwitchX = 41, SwitchZ = 44 },
            new BotExit { Powered = true, Progress = 80, SwitchX = 58, SwitchZ = 27 } }; view.ExitCount = 2;
        var brain = new KillerBrain();
        brain.Update(view, _nav, _map, new Random(1));
        Assert.Equal(view.TerminalCount, Read<int>(brain, "_patrol"));
        float dx = Read<float>(brain, "_patrolX") - 58, dz = Read<float>(brain, "_patrolZ") - 27;
        Assert.InRange(dx * dx + dz * dz, 0, 9.01f);
    }

    [Fact]
    public void KillerDoesNotKickWhileANormalSurvivorIsInSight()
    {
        var view = Killer(); view.X = 41; view.Z = 44;
        view.Blips.Add(new KillerBotView.Blip { X = 41, Z = 40.5f });
        var brain = new KillerBrain(); var rng = new Random(1);
        for (int i = 0; i < 10; i++)
        {
            view.Time = i * .05;
            Assert.False(brain.Update(view, _nav, _map, rng).Interact);
        }
    }

    [Fact]
    public void VisibleHatchIsUsedByTheLastSurvivorAndClosedByTheKiller()
    {
        var survivor = Survivor(); survivor.HatchVisible = true; survivor.HatchX = 41; survivor.HatchZ = 43;
        Assert.True(Step(new SurvivorBrain(), survivor, new Random(1)).Interact);
        var killer = Killer(); killer.HatchVisible = true; killer.HatchX = 41; killer.HatchZ = 43;
        Assert.True(new KillerBrain().Update(killer, _nav, _map, new Random(1)).Interact);
    }
}

using PingTheKiller.ServerCore;
using PingTheKiller.ServerCore.Map;
using PingTheKiller.Shared.Game;
using Xunit;

namespace PingTheKiller.Tests.Core;

// Post-merge bot-freeze fix: ThreatLevel 2+ from a killer that neither comes closer nor is seen moving (an idle human
// killer, camping) used to keep a survivor bot paused for good. A SurvivorBrain is driven here through its
// SurvivorBotView alone on the real map: one incomplete terminal (index 4, (41, 44)), the killer standing still out of
// sight at its spawn (34, 43.5), 7 m from that terminal.
public sealed class SurvivorCampTests
{
    private const float Dt = 0.05f;
    private const int Terminal = 4;

    private sealed class Sim
    {
        internal readonly FixedMap Map = new FixedMap();
        internal readonly NavGrid Nav;
        internal readonly SurvivorBrain Brain = new SurvivorBrain();
        internal readonly SurvivorBotView View = new SurvivorBotView();
        internal readonly System.Random Random;
        internal float KillerX = 34f, KillerZ = 43.5f, KillerYaw;
        internal bool KillerVisible;
        internal double Time;
        internal BotIntent Intent;

        internal Sim(int seed, float x, float z)
        {
            Nav = new NavGrid(Map);
            Random = new System.Random(seed);
            Assert.True(Map.CanStand(x, z));
            View.SelfId = 1;
            View.X = x;
            View.Z = z;
            View.Speed = GameConstants.SurvivorSpeed;
            View.Status = PlayerStatus.Normal;
            View.Skill = SkillIds.EmergencyRestore;
            View.Terminals = Map.CreateTerminals(1, out byte required);
            View.TerminalCount = View.Terminals.Length;
            View.TerminalsRequired = required;
            for (int i = 0; i < View.TerminalCount; i++)
                if (i != Terminal) View.Terminals[i].Progress = 100;
        }

        internal float TerminalDistance => Dist(View.X, View.Z, View.Terminals[Terminal].X, View.Terminals[Terminal].Z);
        internal bool Hacking => Intent.Interact && TerminalDistance <= SurvivorBrain.HackStopDistance + 0.1f;
        internal bool HackingAt(int index) => Intent.Interact &&
            Dist(View.X, View.Z, View.Terminals[index].X, View.Terminals[index].Z) <= SurvivorBrain.HackStopDistance + 0.1f;

        // One 20 Hz tick: fill the view like GameServer.FillSurvivorView, decide, then move the bot on the map.
        internal void Step()
        {
            Time += Dt;
            View.Time = Time;
            View.Threat = GameServer.ThreatForDistance(Dist(View.X, View.Z, KillerX, KillerZ));
            View.KillerVisible = KillerVisible;
            View.KillerX = KillerVisible ? KillerX : 0;
            View.KillerZ = KillerVisible ? KillerZ : 0;
            View.KillerYaw = KillerVisible ? KillerYaw : 0;
            Intent = Brain.Update(View, Nav, Map, Random);
            float step = View.Speed * Dt;
            var next = Map.Move(View.X, View.Z, Intent.DirX * step, Intent.DirZ * step);
            bool moved = Dist(next.X, next.Z, View.X, View.Z) > 0.001f;
            View.X = next.X;
            View.Z = next.Z;
            // Moving or hacking is Signal; the WorldState of the next tick carries it in this bot's own entry.
            View.Team.Clear();
            View.Team.Add(new PlayerState
            {
                Id = 1, Role = (byte)Role.Survivor, Status = (byte)PlayerStatus.Normal, X = View.X, Z = View.Z,
                Flags = (byte)(moved || Intent.Interact ? PlayerFlags.Signal : PlayerFlags.None)
            });
        }

        // Runs until the bot hacks at the terminal; returns false on time-out.
        internal bool RunUntilHacking(double seconds)
        {
            for (double end = Time + seconds; Time < end;)
            {
                Step();
                if (Hacking) return true;
            }
            return false;
        }
    }

    private static float Dist(float x, float z, float tx, float tz)
    {
        float dx = x - tx, dz = z - tz;
        return (float)System.Math.Sqrt(dx * dx + dz * dz);
    }

    // The idle unseen killer is within ThreatLevel 2 of the hacking spot of the last incomplete terminal: after the scare
    // the bot works it anyway (it used to pause there until the match timer ran out).
    [Theory]
    [InlineData(1)]
    [InlineData(2)]
    [InlineData(3)]
    [InlineData(4)]
    [InlineData(5)]
    public void AnIdleUnseenKillerNearTheLastTerminalDoesNotFreezeTheBot(int seed)
    {
        var sim = new Sim(seed, 41f, 38f);
        double hacking = 0, maxThreatWhileHacking = 0;
        for (int i = 0; i < 180 * 20; i++)
        {
            sim.Step();
            if (!sim.Hacking) continue;
            hacking += Dt;
            maxThreatWhileHacking = System.Math.Max(maxThreatWhileHacking, sim.View.Threat);
        }
        // Hack bursts are 2-4 s with 8-16 s pauses, so 180 s of free work is well above 20 s at the terminal.
        Assert.True(hacking >= 20, $"seed {seed}: hacked {hacking:0.0} s in 180 s next to an idle unseen killer");
        Assert.True(maxThreatWhileHacking >= 2, "the hacking spot must be inside ThreatLevel 2 for this test to mean anything");
    }

    // V2: sight triggers hiding even for an idle killer. Work resumes once it is unseen and the camp goes stale.
    [Fact]
    public void AnIdleKillerSeenThenHiddenDoesNotFreezeTheBot()
    {
        var sim = new Sim(7, 41f, 38f) { KillerVisible = true, KillerYaw = 90f };
        for (int i = 0; i < 100; i++) { sim.Step(); Assert.False(sim.Hacking); }
        sim.KillerVisible = false;
        Assert.True(sim.RunUntilHacking(120), "the bot never resumed after the killer became unseen");
    }

    // Once the bot works next to the camping killer, a rising ThreatLevel (the killer walks at it, still unseen) makes it
    // stop hacking and flee at once, as before the fix.
    [Theory]
    [InlineData(1)]
    [InlineData(2)]
    [InlineData(3)]
    public void ARisingThreatStillInterruptsTheHackAndMakesTheBotFlee(int seed)
    {
        var sim = new Sim(seed, 41f, 38f);
        Assert.True(sim.RunUntilHacking(120), "the bot never hacked");
        Assert.True(sim.View.Threat == 2, $"threat at the hacking spot {sim.View.Threat}");
        float hackX = sim.View.X, hackZ = sim.View.Z;
        // The killer closes in to 4 m (ThreatLevel 3) while the bot is Signal at the terminal.
        sim.KillerX = hackX - 4f;
        sim.KillerZ = hackZ;
        sim.Step();
        Assert.Equal(3, sim.View.Threat);
        bool stopped = false;
        for (int i = 0; i < 20 && !stopped; i++) { sim.Step(); stopped = !sim.Intent.Interact; }
        Assert.True(stopped, "still hacking 1 s after ThreatLevel rose to 3");
        for (int i = 0; i < 5 * 20; i++) sim.Step();
        Assert.True(Dist(sim.View.X, sim.View.Z, hackX, hackZ) > 3f, "the bot did not flee from the rising threat");
    }

    // A killer seen walking at the bot (the existing coming rule) still interrupts work next to a former camp.
    [Fact]
    public void AKillerSeenComingStillInterruptsTheHack()
    {
        var sim = new Sim(11, 41f, 38f);
        Assert.True(sim.RunUntilHacking(120), "the bot never hacked");
        float hackX = sim.View.X, hackZ = sim.View.Z;
        // The killer appears 9 m away (ThreatLevel 2) and walks straight at the bot.
        sim.KillerVisible = true;
        sim.KillerX = hackX;
        sim.KillerZ = hackZ - 9f;
        sim.KillerYaw = 0f;
        bool stopped = false;
        for (int i = 0; i < 20 && !stopped; i++)
        {
            sim.KillerZ += 0.2f;
            sim.Step();
            stopped = !sim.Intent.Interact;
        }
        Assert.True(stopped, "still hacking 1 s after the killer was seen coming");
    }

    // Attempt 2: every stale phase notes the camp once, not only the first one. The bot works T4 next to the idle unseen
    // killer (its first camp phase; no other work left). Then T1 (58, 27) becomes workable again (regressed), and the
    // killer shows up in sight 11 m off - same ThreatLevel 2, more than TerminalDangerRadius from T4 - shuffles (acute, no
    // rise) and idles there. When that second phase turns stale the bot must leave T4 for T1; before the fix it stayed.
    [Theory]
    [InlineData(1)]
    [InlineData(2)]
    [InlineData(3)]
    public void ASecondCampPhaseLeavesTheTerminalAgain(int seed)
    {
        const int other = 1;
        var sim = new Sim(seed, 41f, 38f);
        Assert.True(sim.RunUntilHacking(120), "the bot never hacked T4");
        float hackX = sim.View.X, hackZ = sim.View.Z;
        Assert.Equal(2, sim.View.Threat);
        sim.View.Terminals[other].Progress = 40;
        sim.KillerX = hackX - 11f;
        sim.KillerZ = hackZ - 1f;
        Assert.True(Dist(sim.KillerX, sim.KillerZ, sim.View.Terminals[Terminal].X, sim.View.Terminals[Terminal].Z) > 10f);
        // Facing half toward the bot: watched, not coming.
        float yawToBot = (float)(System.Math.Atan2(hackX - sim.KillerX, hackZ - sim.KillerZ) * 180 / System.Math.PI);
        sim.KillerYaw = yawToBot - 50f;
        sim.KillerVisible = true;
        for (int i = 0; i < 5; i++)
        {
            sim.KillerZ += 0.1f;
            sim.Step();
            Assert.Equal(2, sim.View.Threat);
        }
        // The camp exception applies after the killer becomes unseen; continuous sight still requires hiding in v2.
        sim.KillerVisible = false;
        bool atOther = false;
        for (int i = 0; i < 90 * 20 && !atOther; i++)
        {
            sim.Step();
            atOther = sim.HackingAt(other);
        }
        Assert.True(atOther, $"seed {seed}: not at T1 90 s after the second camp phase began (at {sim.View.X:0.0}, {sim.View.Z:0.0})");
    }

    // Attempt 2: a killer remembered (seen) right at the last terminal blocks it even on the fallback pass once it camps:
    // the bot never walks into it. The killer stands 1 m in front of T4 on the bot's side, in sight and idle.
    [Theory]
    [InlineData(1)]
    [InlineData(2)]
    [InlineData(3)]
    public void AKillerRememberedAtTheTerminalIsNeverWalkedInto(int seed)
    {
        var sim = new Sim(seed, 41f, 36f) { KillerX = 41f, KillerZ = 43f, KillerYaw = 180f, KillerVisible = true };
        float closest = float.MaxValue;
        for (int i = 0; i < 120 * 20; i++)
        {
            sim.Step();
            Assert.False(sim.Hacking, $"seed {seed}: hacked T4 next to the killer at t={sim.Time:0.0}");
            closest = System.Math.Min(closest, Dist(sim.View.X, sim.View.Z, sim.KillerX, sim.KillerZ));
        }
        Assert.True(closest > GameConstants.CaptureRadius + 1f, $"seed {seed}: came within {closest:0.00} m of the killer");
    }
}

