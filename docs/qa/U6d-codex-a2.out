+    [Theory]
+    [InlineData(45, 0)]
+    [InlineData(55, 1)]
+    [InlineData(60, 1)]
+    public void TerminalStickinessRequiresAtLeastFifteenMoreProgress(int progress, int expected)
+    {
+        var view = Survivor(); var brain = new SurvivorBrain(); var rng = new Random(1);
+        for (int i = 0; i < 300; i++) Step(brain, view, rng);
+        Assert.Equal(0, Read<int>(brain, "_terminal"));
+        view.Terminals[1].Progress = (byte)progress;
+        for (int i = 0; i < 20; i++) Step(brain, view, rng);
+        Assert.Equal(expected, Read<int>(brain, "_terminal"));
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-4)]
+    public void EscapeRescueClampsNonPositiveSpeed(float speed)
+    {
+        var view = Survivor(); view.Speed = speed; view.CollapseLeft = 100;
+        view.Team.Add(Ally(2, 44, 43, PlayerStatus.Lagging, 30));
+        view.Exits = new[] { new BotExit { X = 48, Z = 44, Open = true, Powered = true } }; view.ExitCount = 1;
+        var brain = new SurvivorBrain(); Step(brain, view, new Random(2));
+        Assert.Equal(48, Read<float>(brain, "_goalX"));
+        Assert.True(float.IsFinite(Read<float>(brain, "_goalZ")));
+        var affordable = typeof(SurvivorBrain).GetMethod("CanRescueBeforeEscape", BindingFlags.Static | BindingFlags.NonPublic)!;
+        Assert.False((bool)affordable.Invoke(null, new object[] { view, 0, 0 })!);
+    }
+
+    [Fact]
+    public void PoweredSwitchHolderRescuesReachableAllyBeforeOpeningExit()
+    {
+        var view = Survivor(); view.Team.Add(Ally(1, view.X, view.Z));
+        view.Team.Add(Ally(2, 45, 43, PlayerStatus.Lagging, 12));
+        view.Exits = new[] { new BotExit { Powered = true, Progress = 80, SwitchX = 41, SwitchZ = 43 } }; view.ExitCount = 1;
+        var brain = new SurvivorBrain(); var rng = new Random(3);
+        Step(brain, view, rng);
+        Assert.Equal(45, Read<float>(brain, "_goalX"));
+        for (int i = 0; i < 80; i++)
+        {
+            var intent = Step(brain, view, rng);
+            var next = _map.Move(view.X, view.Z, intent.DirX * .2f, intent.DirZ * .2f);
+            view.X = next.X; view.Z = next.Z;
+        }
+        Assert.InRange(Distance(view.X, view.Z, 45, 43), 0, GameConstants.RescueRadius);
+    }
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void KillerKeepsPatrollingWhenAllWorkWasRecentlyVisitedOrDone(bool done)
+    {
+        var view = Killer(); var brain = new KillerBrain(); var rng = new Random(1);
+        brain.Update(view, _nav, _map, rng);
+        Array.Fill(Read<double[]>(brain, "_visitedAt"), 0);
+        typeof(KillerBrain).GetField("_patrol", BindingFlags.Instance | BindingFlags.NonPublic)!.SetValue(brain, -1);
+        for (int i = 0; i < view.TerminalCount; i++) view.Terminals[i].Done = done;
+        float travelled = 0; double stopped = 0, longest = 0;
+        for (int i = 0; i < 600; i++)
+        {
+            view.Time += .05;
+            var intent = brain.Update(view, _nav, _map, rng);
+            var next = _map.Move(view.X, view.Z, intent.DirX * view.Speed * .05f, intent.DirZ * view.Speed * .05f);
+            float movement = Distance(view.X, view.Z, next.X, next.Z);
+            travelled += movement;
+            stopped = movement < .001f && !intent.Interact ? stopped + .05 : 0;
+            longest = Math.Max(longest, stopped);
+            view.X = next.X; view.Z = next.Z; view.Yaw = intent.Yaw;
+        }
+        Assert.True(travelled >= 15, $"travelled {travelled:0.0}m");
+        Assert.True(longest <= 4.5, $"stopped {longest:0.00}s");
+    }
+
+    [Fact]
+    public void KillerFallbackPrefersRecentSignalThenLeastRecentlyVisitedWork()
+    {
+        var view = Killer(); var brain = new KillerBrain(); var rng = new Random(1);
+        brain.Update(view, _nav, _map, rng);
+        Read<double[]>(brain, "_visitedAt")[0] = -10;
+        Read<double[]>(brain, "_visitedAt")[1] = -5;
+        Read<double[]>(brain, "_signalAt")[1] = 0;
+        typeof(KillerBrain).GetField("_patrol", BindingFlags.Instance | BindingFlags.NonPublic)!.SetValue(brain, -1);
+        view.Time = 1;
+        brain.Update(view, _nav, _map, rng);
+        Assert.Equal(1, Read<int>(brain, "_patrol"));
+    }
+
+    private static float Distance(float x, float z, float tx, float tz) => MathF.Sqrt((x - tx) * (x - tx) + (z - tz) * (z - tz));
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void EscapeDetoursAroundVisibleStillKillerOrUsesAnotherOpenExit(bool anotherExit)
+    {
+        var view = Survivor(); view.X = 5; view.Z = 25; view.KillerVisible = true; view.KillerX = 5; view.KillerZ = 15;
+        view.Exits = anotherExit
+            ? new[] { new BotExit { X = 5, Z = 5, Open = true }, new BotExit { X = 5, Z = 40, Open = true } }
+            : new[] { new BotExit { X = 5, Z = 5, Open = true } };
+        view.ExitCount = view.Exits.Length;
+        var brain = new SurvivorBrain(); var rng = new Random(2);
+        bool escaped = false;
+        for (int i = 0; i < 1200 && !escaped; i++)
+        {
+            var intent = Step(brain, view, rng);
+            var next = _map.Move(view.X, view.Z, intent.DirX * .2f, intent.DirZ * .2f);
+            view.X = next.X; view.Z = next.Z;
+            Assert.True(Distance(view.X, view.Z, view.KillerX, view.KillerZ) > GameConstants.CaptureRadius + 1,
+                $"entered capture buffer at {view.X:0.00},{view.Z:0.00}");
+            escaped = view.Exits.Any(e => Distance(view.X, view.Z, e.X, e.Z) <= GameConstants.ExitRadius);
+        }
+        Assert.True(escaped, $"escape stalled at {view.X:0.00},{view.Z:0.00}");
+    }
+
+    [Fact]
+    public void CampingKillerDoesNotSuppressAffordableCollapseRescue()
+    {
+        var view = Survivor(); view.KillerVisible = true; view.KillerX = 41; view.KillerZ = 38; view.Threat = 2;
+        var brain = new SurvivorBrain(); var rng = new Random(2);
+        for (int i = 0; i < 650; i++) Step(brain, view, rng);
+        view.Team.Add(Ally(2, 44, 43, PlayerStatus.Lagging, 30));
+        view.CollapseLeft = 100;
+        view.Exits = new[] { new BotExit { X = 48, Z = 44, Open = true } }; view.ExitCount = 1;
+        for (int i = 0; i < 20; i++) Step(brain, view, rng);
+        Assert.Equal(44, Read<float>(brain, "_goalX"));
+    }
 }
 
diff --git a/Server.Tests/Core/SurvivorCampTests.cs b/Server.Tests/Core/SurvivorCampTests.cs
index a0792c993453e371e83698b47c753d2f79fc3bd2..29ee15c77fc65061ca301200b9823c61ca12f0ee
--- a/Server.Tests/Core/SurvivorCampTests.cs
+++ b/Server.Tests/Core/SurvivorCampTests.cs
@@ -116,7 +116,7 @@
         Assert.True(maxThreatWhileHacking >= 2, "the hacking spot must be inside ThreatLevel 2 for this test to mean anything");
     }
 
-    // V2: sight triggers hiding even for an idle killer. Work resumes once it is unseen and the camp goes stale.
+    // Sight initially triggers hiding; stale camping releases work when the killer becomes unseen.
     [Fact]
     public void AnIdleKillerSeenThenHiddenDoesNotFreezeTheBot()
     {
@@ -201,7 +201,7 @@
             sim.Step();
             Assert.Equal(2, sim.View.Threat);
         }
-        // The camp exception applies after the killer becomes unseen; continuous sight still requires hiding in v2.
+        // This variant loses sight; continuous sight is covered separately below.
         sim.KillerVisible = false;
         bool atOther = false;
         for (int i = 0; i < 90 * 20 && !atOther; i++)
@@ -230,4 +230,31 @@
         }
         Assert.True(closest > GameConstants.CaptureRadius + 1f, $"seed {seed}: came within {closest:0.00} m of the killer");
     }
+
+    [Fact]
+    public void VisibleCampReleasesOccludedWorkWithinFortySecondsAndMovementRestoresHiding()
+    {
+        var sim = new Sim(7, 41, 38) { KillerVisible = true, KillerX = 8, KillerZ = 38 };
+        Assert.True(Dist(sim.View.X, sim.View.Z, sim.KillerX, sim.KillerZ) > GameConstants.ThreatLevel2Distance);
+        bool hackedByForty = false;
+        for (int i = 0; i < 60 * 20; i++)
+        {
+            sim.Step();
+            if (!sim.Hacking) continue;
+            Assert.True(sim.Map.SegmentBlocked(sim.KillerX, sim.KillerZ,
+                sim.View.Terminals[Terminal].X, sim.View.Terminals[Terminal].Z));
+            if (sim.Time <= 40) hackedByForty = true;
+        }
+        Assert.True(hackedByForty, $"no occluded hack within 40s; position {sim.View.X},{sim.View.Z}");
+        bool hid = false;
+        for (int i = 0; i < 20; i++)
+        {
+            sim.KillerX += .1f;
+            sim.Step();
+            hid |= (bool)typeof(SurvivorBrain).GetField("_hiding",
+                System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!.GetValue(sim.Brain)!;
+        }
+        Assert.True(hid, "visible killer movement did not restore hiding");
+        Assert.False(sim.Intent.Interact);
+    }
 }

