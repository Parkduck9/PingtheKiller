+                    float x = view.KillerX + (float)Math.Cos(angle) * radius;
+                    float z = view.KillerZ + (float)Math.Sin(angle) * radius;
+                    if (!SafeEscapePath(nav, view, view.X, view.Z, x, z, out float first)) continue;
