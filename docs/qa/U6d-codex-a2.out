+        private void Survey(KillerBotView view, NavGrid nav)
+        {
+            float farthest = -1;
+            foreach (var spot in nav.Spots)
+            {
+                float distance = Distance(view.X, view.Z, spot.X, spot.Z);
+                if (distance <= farthest) continue;
+                farthest = distance; _patrolX = spot.X; _patrolZ = spot.Z;
+            }
+            _patrolUntil = view.Time + farthest * 2 / Math.Max(0.1f, view.Speed) + PatrolTimeout;
+        }
