+    public void TerminalStickinessRequiresAtLeastFifteenMoreProgress(int progress, int expected)
+    {
+        var view = Survivor(); var brain = new SurvivorBrain(); var rng = new Random(1);
+        for (int i = 0; i < 300; i++) Step(brain, view, rng);
+        Assert.Equal(0, Read<int>(brain, "_terminal"));
+        view.Terminals[1].Progress = (byte)progress;
