        private void PlanRescue(SurvivorBotView view, int target)
        {
            var ally = view.Team[target];
            _terminal = -1;
            if (Distance(view.X, view.Z, ally.X, ally.Z) <= GameConstants.RescueRadius - 0.5f) _mode = ModePause;
            else Plan(ally.X, ally.Z, GameConstants.RescueRadius - 0.7f, false);
        }

        private static bool RescueUrgent(SurvivorBotView view, int target)
        {
            var ally = view.Team[target];
            double arrival = Distance(view.X, view.Z, ally.X, ally.Z) * 1.4 / Math.Max(0.1f, view.Speed);
            return ally.StatusTimer < arrival + GameConstants.RescueTimeSeconds + 13;
        }

        private static bool CanRescueBeforeEscape(SurvivorBotView view, int target, int exit)
        {
            var ally = view.Team[target];
            double arrive = Distance(view.X, view.Z, ally.X, ally.Z) * 1.4 / view.Speed;
            double leave = Distance(ally.X, ally.Z, view.Exits[exit].X, view.Exits[exit].Z) * 1.4 / view.Speed;
            // A Lagging ally consumes twice as much collapse clock until the rescue completes.
            return arrive < 4 && (view.CollapseLeft < 0 ||
                (arrive + GameConstants.RescueTimeSeconds) * GameConstants.CollapseLaggingRate + leave + 3 < view.CollapseLeft);
        }

        // A random lattice spot (NavGrid.Spots) at least HideoutDistance away (the farthest one if none is).
        private void PickHideout(SurvivorBotView view, NavGrid nav, Random random)
        {
            int options = nav.Spots.Count;
            if (options == 0) { _hideX = view.X; _hideZ = view.Z; return; }
            int start = random.Next(options);
            float bestDistance = -1;
            for (int k = 0; k < options; k++)
            {
                var spot = nav.Spots[(start + k) % options];
                float distance = Distance(view.X, view.Z, spot.X, spot.Z);
                if (distance <= bestDistance) continue;
                bestDistance = distance;
                _hideX = spot.X;
                _hideZ = spot.Z;
                if (distance >= HideoutDistance) break;
            }
        }

        // Lagging: always visible and slow, so it moves openly toward the nearest Normal teammate, away from a killer it sees.
        private void UpdateLagging(ref BotIntent intent, SurvivorBotView view, NavGrid nav, FixedMap map, Random random)
        {
            double t = view.Time;
            if (view.KillerVisible && Distance(view.X, view.Z, view.KillerX, view.KillerZ) <= 6f)
            {
                float dx = view.X - view.KillerX, dz = view.Z - view.KillerZ;
                float len = (float)Math.Sqrt(dx * dx + dz * dz);
                if (len > 0.01f && MoveTo(ref intent, nav, view.X, view.Z, view.X + dx / len * 3, view.Z + dz / len * 3, 0.2f, view.Speed, t, random)) { }
                return;
            }
            float best = float.MaxValue, tx = view.X, tz = view.Z;
            foreach (var ally in view.Team)
            {
                if (ally.Id == view.SelfId || ally.Status != (byte)PlayerStatus.Normal) continue;
                float d = Distance(view.X, view.Z, ally.X, ally.Z);
                if (d < best) { best = d; tx = ally.X; tz = ally.Z; }
            }
            if (best == float.MaxValue) Stop(ref intent, view.X, view.Z);
            else MoveTo(ref intent, nav, view.X, view.Z, tx, tz, StopDistance, view.Speed, t, random);
        }

        private void UseSkills(ref BotIntent intent, SurvivorBotView view)
        {
            if (!view.SkillReady) return;
            // A flee skill is wanted only while that flee lasts. A decoy also covers the start of a hack burst (hacking is
            // Signal, so fake Signals elsewhere make the real one harder to pick).
            bool use = _wantSkill && view.Time < _fleeUntil;
            if (view.Skill == SkillIds.TrafficOverload &&
                ((view.KillerVisible && Distance(view.X, view.Z, view.KillerX, view.KillerZ) <= 10) ||
                (view.Threat >= 3 && (intent.DirX != 0 || intent.DirZ != 0)))) use = true;
            if (_mode != ModeHack) _coverHack = false;
            else if (_coverHack && (view.Skill == SkillIds.DummyPacket || view.Skill == SkillIds.WhiteNoise))
            {
                use = true;
                _coverHack = false;
            }
            if (view.Skill == SkillIds.EmergencyRestore)
            {
                use = false;
                foreach (var ally in view.Team)
                    if (ally.Id != view.SelfId && ally.Status == (byte)PlayerStatus.Lagging &&
                        Distance(view.X, view.Z, ally.X, ally.Z) <= SkillIds.EmergencyRestoreRadius) use = true;
            }
            else if (view.Skill == SkillIds.StealthRelay && _mode == ModeHack && view.Threat >= 1)
            {
                use = true;
            }
            if (!use) return;
            intent.UseSkill = true;
            _wantSkill = false;
        }
    }
}
using System;
using PingTheKiller.ServerCore.Map;
using PingTheKiller.Shared.Game;

namespace PingTheKiller.ServerCore
{
    // Shared static-map movement for both brains; phantoms use the same PathFollower.
    internal abstract class BotBrain
    {
        internal const float StopDistance = 1.0f;
        internal const float StuckFraction = 0.3f;

        // The server tick of the last update; a gap means the slot was a human meanwhile, so the brain starts over.
        internal uint LastTick;
        internal bool Started;

        private readonly PathFollower _route = new PathFollower();
        private float _yaw;
        protected static double Uniform(Random random, double min, double max) => min + random.NextDouble() * (max - min);

        protected static float Distance(float x, float z, float tx, float tz)
        {
            float dx = x - tx, dz = z - tz;
            return (float)Math.Sqrt(dx * dx + dz * dz);
        }

        protected static float YawOf(float dx, float dz)
        {
            float yaw = (float)(Math.Atan2(dx, dz) * 180 / Math.PI);
            return yaw < 0 ? yaw + 360 : yaw;
        }

        protected float Facing => _yaw;

        protected void Stop(ref BotIntent intent, float x, float z)
        {
            _route.Pause();
            intent.DirX = intent.DirZ = 0;
            intent.Yaw = _yaw;
        }

        protected void Face(ref BotIntent intent, float yaw)
        {
            _yaw = ((yaw % 360) + 360) % 360;
            intent.Yaw = _yaw;
        }

        // Steps toward (tx, tz) along the NavGrid route. Returns true (and stops) when within stop distance.
        protected bool MoveTo(ref BotIntent intent, NavGrid nav, float x, float z, float tx, float tz, float stop,
            float speed, double time, Random random)
        {
            if (Distance(x, z, tx, tz) <= Math.Max(stop, 0.05f))
            {
                Stop(ref intent, x, z);
                return true;
            }
            _route.Direction(nav, x, z, tx, tz, speed, time, out float dx, out float dz);
            intent.DirX = dx;
            intent.DirZ = dz;
            if (dx != 0 || dz != 0) _yaw = YawOf(dx, dz);
            intent.Yaw = _yaw;
            return false;
        }
    }
}
using System;
using System.Collections.Generic;

namespace PingTheKiller.ServerCore.Map
{
    // Static 0.5 m occupancy, shared by every bot. Scratch buffers belong to the single game-loop thread.
    public sealed class NavGrid
    {
        public const float CellSize = 0.5f;
        public const float Clearance = FixedMap.PlayerRadius + 0.05f;
        public const int Cells = (int)(FixedMap.Size / CellSize);
        public const int NodeCount = Cells * Cells;
        private static readonly int[] StepX = { 1, -1, 0, 0, 1, 1, -1, -1 };
        private static readonly int[] StepZ = { 0, 0, 1, -1, 1, -1, 1, -1 };
        private readonly FixedMap _map;
        private readonly bool[] _walkable = new bool[NodeCount];
        private readonly Wall[] _inflated;
        private readonly int[] _stamp = new int[NodeCount], _closed = new int[NodeCount];
        private readonly int[] _cost = new int[NodeCount], _parent = new int[NodeCount];
        private readonly int[] _heap = new int[NodeCount], _heapIndex = new int[NodeCount];
        private readonly int[] _priority = new int[NodeCount], _chain = new int[NodeCount];
        private readonly List<MapPoint> _steerPath = new List<MapPoint>(128);
        private int _generation, _heapCount;

        public NavGrid(FixedMap map)
        {
            if (map == null) throw new ArgumentNullException(nameof(map));
            _map = map;
            _inflated = new Wall[map.Walls.Count + map.Obstacles.Count];
            int k = 0;
            foreach (var w in map.Walls) _inflated[k++] = Inflate(w.MinX, w.MinZ, w.MaxX, w.MaxZ);
            foreach (var o in map.Obstacles) _inflated[k++] = Inflate(o.MinX, o.MinZ, o.MaxX, o.MaxZ);
            for (int i = 0; i < NodeCount; i++) _walkable[i] = PointClear(Center(i));
            var spots = new List<MapPoint>();
            for (float x = 1.5f; x < FixedMap.Size; x += 3)
                for (float z = 1.5f; z < FixedMap.Size; z += 3)
                    if (map.CanStand(x, z, Clearance + .5f)) spots.Add(new MapPoint(x, z));
            Spots = spots.AsReadOnly();
        }

        private static Wall Inflate(float x, float z, float xx, float zz) =>
            new Wall(x - Clearance, z - Clearance, xx + Clearance, zz + Clearance);
        public IReadOnlyList<MapPoint> Spots { get; }
        public bool IsWalkable(int cell) => cell >= 0 && cell < NodeCount && _walkable[cell];
        public static MapPoint Center(int cell) => new MapPoint((cell / Cells + .5f) * CellSize, (cell % Cells + .5f) * CellSize);
        public static int Cell(float x, float z) =>
            Math.Max(0, Math.Min(Cells - 1, (int)(x / CellSize))) * Cells + Math.Max(0, Math.Min(Cells - 1, (int)(z / CellSize)));
        private bool PointClear(MapPoint p)
        {
            for (int i = 0; i < _inflated.Length; i++)
            {
                var w = _inflated[i];
                if (p.X >= w.MinX && p.X <= w.MaxX && p.Z >= w.MinZ && p.Z <= w.MaxZ) return false;
            }
            return p.X >= Clearance && p.X <= FixedMap.Size - Clearance && p.Z >= Clearance && p.Z <= FixedMap.Size - Clearance;
        }

        public bool LineClear(float x, float z, float tx, float tz)
        {
            for (int i = 0; i < _inflated.Length; i++)
                if (_inflated[i].IntersectsSegment(x, z, tx, tz)) return false;
            return true;
        }

        // Collision sliding or a human takeover may leave a body inside the extra 5 cm navigation margin.
        // Permit only the initial segment to leave boxes that contain the start, validating the actual body throughout.
        private bool StartLineClear(float x, float z, float tx, float tz)
        {
            bool escape = false;
            for (int i = 0; i < _inflated.Length; i++)
            {
                var w = _inflated[i];
                if (!w.IntersectsSegment(x,z,tx,tz)) continue;
                if (x < w.MinX || x > w.MaxX || z < w.MinZ || z > w.MaxZ) return false;
                escape = true;
            }
            if (!escape) return true;
            int samples = Math.Max(1,(int)Math.Ceiling(Math.Max(Math.Abs(tx-x),Math.Abs(tz-z))/.025f));
            for (int i=0;i<=samples;i++)
                if (!_map.CanStand(x+(tx-x)*i/samples,z+(tz-z)*i/samples)) return false;
            return true;
        }
        // Both orthogonal neighbours must be free for a diagonal step.
        public bool CanStep(int cell, int direction, out int next)
        {
            int cx = cell / Cells, cz = cell % Cells;
            int x = cx + StepX[direction], z = cz + StepZ[direction];
            next = x * Cells + z;
            if (x < 0 || z < 0 || x >= Cells || z >= Cells || !_walkable[next]) return false;
            return direction < 4 || (_walkable[x * Cells + cz] && _walkable[cx * Cells + z]);
        }

        private int Nearest(float x, float z, bool requireConnection)
        {
            int cell = Cell(x, z), best = -1;
            float distance = float.MaxValue;
            int cx = cell / Cells, cz = cell % Cells;
            for (int ix = Math.Max(0, cx - 8); ix <= Math.Min(Cells - 1, cx + 8); ix++)
                for (int iz = Math.Max(0, cz - 8); iz <= Math.Min(Cells - 1, cz + 8); iz++)
                {
                    int n = ix * Cells + iz;
                    if (!_walkable[n]) continue;
                    var p = Center(n);
                    float d = (p.X - x) * (p.X - x) + (p.Z - z) * (p.Z - z);
                    if (d < distance && (!requireConnection || StartLineClear(x, z, p.X, p.Z))) { best = n; distance = d; }
                }
            return best;
        }

        // Octile distance is admissible for costs 1000 / 1414. A heap with decrease-key bounds scratch storage.
        private static int Heuristic(int a, int b)
        {
            int dx = Math.Abs(a / Cells - b / Cells), dz = Math.Abs(a % Cells - b % Cells);
            return 1000 * Math.Max(dx, dz) + 414 * Math.Min(dx, dz);
        }
        private bool Before(int a, int b) => _priority[a] < _priority[b] || (_priority[a] == _priority[b] && _cost[a] > _cost[b]);
        private void PushUp(int cell, int index)
        {
