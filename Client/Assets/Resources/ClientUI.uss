/* Selectors are prefixed with .root so they outrank the default theme's .unity-* class rules.
   Spacing (margin/padding/offsets) uses only 4/8/12/16/24/32; heights and widths are sizes.
   Text sizing: every text element is single-line (nowrap). Yoga rounds a measured text width to whole
   pixels, and wrapping text re-wraps at that rounded width, so an unconstrained wrapping label can break
   its last word onto a second line that its one-line height does not cover. Only .message wraps, and it
   has an explicit width so its measured height always matches the rendered lines. */
.root {
    flex-grow: 1;
    background-color: #101113;
    color: #E8E6E1;
    font-size: 18px;
    white-space: nowrap;
}
.root.in-game { background-color: transparent; }
.root .screen { position: absolute; left: 32px; top: 32px; width: 1040px; align-items: flex-start; }

.root .unity-text-element { white-space: nowrap; flex-shrink: 0; }
.root .unity-label {
    margin: 0; padding: 0; margin-bottom: 12px;
    font-size: 18px; color: #E8E6E1;
}
.root .title { font-size: 28px; -unity-font-style: bold; margin-bottom: 8px; }
.root .muted { color: #9A9890; font-size: 14px; margin-bottom: 24px; }
.root .field-label { margin-bottom: 8px; }
.root .message { white-space: normal; width: 960px; min-height: 22px; margin-top: 12px; margin-bottom: 24px; }
.root .note { color: #9A9890; font-size: 14px; margin-top: 4px; margin-bottom: 0; }

.root .unity-button {
    background-image: none; background-color: #1A1C1F; color: #E8E6E1;
    border-color: #9A9890; border-width: 1px; border-radius: 2px;
    min-width: 160px; height: 48px; margin: 0; margin-right: 12px; margin-bottom: 12px;
    padding: 0; padding-left: 16px; padding-right: 16px;
    font-size: 18px; -unity-text-align: middle-left; opacity: 1;
}
.root .unity-button:hover { background-color: #2C2F33; }
.root .unity-button:active,
.root .unity-button:hover:active { background-color: #E8E6E1; color: #101113; }
.root .unity-button:focus { border-color: #E8E6E1; border-width: 2px; }
.root .unity-button.chosen { border-left-width: 4px; }
.root .unity-button:disabled,
.root .unity-button:disabled:hover,
.root .unity-button:disabled:focus {
    background-color: #101113; color: #9A9890; border-color: #2C2F33; border-width: 1px; opacity: 1;
}
.root .unity-button.chosen:disabled { border-left-width: 4px; border-left-color: #9A9890; }

.root .unity-button.primary { background-color: #E8E6E1; color: #101113; min-width: 320px; -unity-font-style: bold; }
.root .unity-button.primary:hover { background-color: #FFFFFF; }
.root .unity-button.primary:active,
.root .unity-button.primary:hover:active { background-color: #9A9890; color: #101113; }
.root .unity-button.primary:focus { border-color: #9A9890; border-width: 4px; }
.root .unity-button.primary:disabled,
.root .unity-button.primary:disabled:hover,
.root .unity-button.primary:disabled:focus {
    background-color: #1A1C1F; color: #9A9890; border-color: #2C2F33; border-width: 1px; opacity: 1;
}

.root .address { width: 560px; height: 48px; margin: 0; padding: 0; font-size: 18px; opacity: 1; }
.root .address .unity-text-field__input {
    background-image: none; background-color: #1A1C1F; color: #E8E6E1;
    border-color: #9A9890; border-width: 1px; border-radius: 2px;
    margin: 0; padding: 0; padding-left: 12px; padding-right: 12px; font-size: 18px; -unity-text-align: middle-left;
}
.root .address:hover .unity-text-field__input { border-color: #E8E6E1; }
.root .address:focus .unity-text-field__input,
.root .address .unity-text-field__input:focus { border-color: #E8E6E1; border-width: 2px; }
.root .address:disabled { opacity: 1; }
.root .address:disabled .unity-text-field__input,
.root .address:disabled:hover .unity-text-field__input {
    background-color: #101113; color: #9A9890; border-color: #2C2F33; border-width: 1px;
}

.root .columns { flex-direction: row; align-items: flex-start; }
.root .roster { width: 560px; margin-right: 32px; }
.root .slot {
    flex-direction: row; align-items: center;
    width: 560px; height: 48px; padding: 0; padding-left: 16px; margin-bottom: 4px;
    background-color: #1A1C1F; border-bottom-width: 1px; border-bottom-color: #2C2F33;
}
.root .slot .unity-label { margin-bottom: 0; -unity-text-align: middle-left; }
/* Fixed-width number column keeps names aligned whatever the digit widths. */
.root .slot-number { width: 32px; }
.root .slot.empty .unity-label { color: #9A9890; }
.root .controls { width: 400px; align-items: flex-start; }
/* R1 (11/17) HUD_SPEC 12.4: the lobby skill picker, a third column (the lobby screen is 1536 u wide). a2: names and
   effect lines at the 18 u body size in the text colour; effect lines are broken by LobbyCopy.PickerEffect (no wrap). */
.root .lobby-wide { width: 1536px; }
.root .controls.with-skills { margin-right: 32px; }
.root .skills { width: 512px; align-items: flex-start; }
.root .pick-chosen { margin-bottom: 12px; white-space: normal; width: 512px; }
.root .pick-group { margin-bottom: 4px; }
.root .unity-label.pick-title { font-size: 14px; color: #9A9890; margin-bottom: 6px; }
.root.s-floor .unity-label.pick-title { font-size: 15px; }
.root .pick-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.root .unity-button.pick { min-width: 192px; width: 192px; height: 36px; margin-right: 12px; margin-bottom: 0; font-size: 18px; }
.root .skills > .unity-button.pick { margin-top: 6px; }
.root .unity-label.pick-effect { font-size: 18px; color: #E8E6E1; white-space: nowrap; width: 308px; margin-bottom: 0; }
.root .section { -unity-font-style: bold; margin-bottom: 16px; }
.root .row { flex-direction: row; align-items: center; margin-bottom: 12px; }
.root .row .unity-label { margin-bottom: 0; margin-right: 16px; }
.root .row .unity-button { margin-bottom: 0; }
.root .actions { flex-direction: row; margin-top: 12px; }

.root .play { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
/* HUD_SPEC 4.5 Lagging stutter: two full-screen layers of the held world image (previous at full opacity, newest at 70 %). */
.root .stutter { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; }
.root .headline { -unity-font-style: bold; margin-top: 16px; margin-bottom: 8px; }
.root .outcome { margin-bottom: 16px; }
/* Dev line (F3, default off): top-left, small, above every screen. */
.root .dev {
    position: absolute; left: 8px; top: 8px; margin: 0; padding: 4px;
    background-color: #101113; color: #9A9890; font-size: 14px;
}
.root .exit {
    position: absolute; background-color: #101113; color: #E8E6E1;
    margin: 0; padding: 4px; font-size: 14px;
    translate: -50% -100%;
}

/* Survivor HUD (HUD_SPEC 4.0): one bottom-center cluster, 672x72 u, 24 u above the bottom edge, panel fill and a 1 u line
   border (re-snapped to 1 physical px in code); blocks [8] skill 176 [8] meter 304 [8] info 160 [8] ((10/30); the outer 8 u gaps
   include the 1 u border, hence 7 u of padding). Prompt row 672x40 u, 8 u above the cluster. Text classes km / ks / kbold /
   kmuted / krow / kbar are shared with the Killer HUD. ally = Survivor-team information, Survivor client only. */
.root .survivor-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.root .scluster {
    position: absolute; bottom: 24px; left: 50%; translate: -50% 0; width: 672px; height: 72px;
    flex-direction: row; align-items: center; padding: 0; padding-left: 7px; padding-right: 7px;
    background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px; border-radius: 0;
}
/* (10/30, U4e Q-02) skill 176 = 8 + ring 64 + 4 + name column 100 (no right padding: the meter's 8 u margin + 8 u padding
   follow); info 160. The longest skill word ("Emergency", S 600 at the 15 u floor ~ 90 u) fits, so names wrap only at
   spaces. */
.root .sskill { width: 176px; height: 70px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 8px; padding-right: 0; }
.root .sskill-text { margin-left: 4px; width: 100px; }
.root .unity-label.sname { white-space: normal; width: 100px; max-height: 36px; overflow: hidden; }
.root .unity-label.ring-count {
    position: absolute; left: 0; top: 0; width: 64px; height: 64px; margin: 0; padding: 0;
    font-size: 18px; color: #E8E6E1; -unity-text-align: middle-center;
}
.root .smeter { width: 304px; height: 70px; flex-shrink: 0; margin-left: 8px; padding: 4px; padding-left: 8px; padding-right: 8px; }
.root .srow-a { flex-direction: row; justify-content: space-between; align-items: center; height: 24px; }
.root .unity-label.ssignal { color: #FFB020; }
.root .smeter-track { width: 288px; height: 16px; margin-top: 4px; border-color: #9A9890; border-width: 1px; border-radius: 0; }
.root .smeter-track.ally-outline { border-color: #3FB8AF; }
.root .sfill { height: 100%; width: 0; }
.root .sfill.fill-ally, .root .kbar.fill-ally { background-color: #3FB8AF; }
.root .kbar.fill-signal { background-color: #FFB020; }
.root .sfill.fill-danger { background-color: #E5484D; }
.root .sfill.fill-signal { background-color: #FFB020; }
.root .sfill.fill-text { background-color: #E8E6E1; }
.root .sinfo { width: 160px; height: 70px; flex-shrink: 0; margin-left: 8px; padding-left: 8px; padding-right: 8px; justify-content: center; }
/* HUD_SPEC 14.1a skill result line: 672x40 in the 13.1 stack, directly above the prompt row; one M line after a 4x18 bar. */
.root .sresult {
    width: 672px; height: 40px; padding: 0; padding-left: 7px; padding-right: 7px; justify-content: center;
    background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px; border-radius: 0;
}
.root .sresult .kbar { margin-right: 8px; }
.root .sprompt {
    position: absolute; bottom: 104px; left: 50%; translate: -50% 0; width: 672px; height: 40px;
    padding: 0; padding-left: 7px; padding-right: 7px; justify-content: center;
    background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px; border-radius: 0;
}
.root .sprompt-track { width: 656px; height: 4px; margin-top: 2px; }
/* (10/30) Eliminated reason: up to two S lines in the meter's row B + gap + row C space (18 + 4 + 16 = 38 u); no bar. */
.root .unity-label.sreason-wrap { white-space: normal; width: 288px; height: 38px; -unity-text-align: upper-left; }
/* HUD_SPEC 4.2 threat noise: 1-bit danger/transparent textures (point filtered), static until the level changes.
   Level 1-2: an 8 u strip on the meter's top edge from the right ((10/30) ruling; the meter's 4 u top padding plus the
   blank top of row A, so it reaches no glyph). Level 3: a 24 u band on all four screen edges (bottom band ends 24 u below
   the cluster: no overlap). */
.root .sthreat-strip { position: absolute; right: 0; top: 0; height: 8px; }
.root .sband { position: absolute; }

/* Killer HUD (HUD_SPEC 6.1): bottom-left cluster, 320 u wide, margin 24 u, blocks with panel fill and a 1 u line border
   (the width is re-snapped to 1 physical px in code), corner radius 0. Type: S 14 / M 18 / L 28; S has a 12 px floor
   at 720p (.s-floor sets 15 u at panel scale 0.8). */
.root .killer-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.root .markers { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.root .killer-cluster { position: absolute; left: 24px; bottom: 24px; width: 320px; flex-direction: column; }
.root .kblock {
    width: 320px; flex-shrink: 0; margin-bottom: 8px; border-radius: 0;
    background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px;
}
.root .kblock.klast { margin-bottom: 0; }
.root .kintro { height: 208px; padding: 12px; }
.root .kmenu { height: 256px; padding: 12px; }
.root .kprompt { height: 56px; padding: 8px; }
.root .kinfo { height: 72px; padding: 0; padding-left: 8px; padding-right: 8px; }
.root .keffect { height: 32px; padding: 4px; flex-direction: row; align-items: center; }
.root .kskill { height: 88px; padding: 3px; padding-left: 8px; padding-right: 8px; flex-direction: row; align-items: center; }
.root .kskill-text { margin-left: 8px; width: 232px; }
.root .krow { flex-direction: row; align-items: center; height: 23px; }
.root .unity-label.kl { font-size: 28px; height: 34px; margin: 0; margin-bottom: 4px; -unity-text-align: middle-left; }
.root .unity-label.km { font-size: 18px; height: 23px; margin: 0; -unity-text-align: middle-left; }
.root .unity-label.ks { font-size: 14px; min-height: 18px; margin: 0; -unity-text-align: middle-left; }
.root.s-floor .unity-label.ks { font-size: 15px; }
.root .unity-label.kline { height: 23px; }
.root .unity-label.kgap { margin-bottom: 4px; }
.root .unity-label.kbold { -unity-font-style: bold; }
.root .unity-label.kmuted { color: #9A9890; }
.root .unity-label.kclip { overflow: hidden; text-overflow: ellipsis; }
.root .unity-label.kwrap { white-space: normal; width: 296px; flex-shrink: 0; }
.root .unity-label.kmenu-effect { margin-bottom: 12px; }
.root .kbar { width: 4px; height: 18px; background-color: #E8E6E1; margin-right: 4px; flex-shrink: 0; }
.root .kbar.danger { background-color: #E5484D; }
.root .unity-button.kbutton { width: 296px; min-width: 0; height: 40px; margin: 0; margin-bottom: 8px; border-radius: 0; }
.root .unity-button.kbutton.klast { margin-bottom: 0; }
/* World tags: S text on a panel fill, 4 u padding; Lagging tags carry a 2 u text left bar. */
.root .unity-label.tag {
    position: absolute; margin: 0; padding: 4px; padding-top: 2px; padding-bottom: 2px;
    background-color: #1A1C1F; color: #E8E6E1;
}
.root .unity-label.tag.tag-muted { color: #9A9890; }
.root .unity-label.tag.tag-lagging { border-left-width: 2px; border-left-color: #E8E6E1; padding-left: 4px; }

/* Settings (U7a): a left-aligned panel, 640 u wide, 24 u from the top-left (top-right over a match); rows are label 240 / control 240 / value 80. */
.root .settings {
    position: absolute; left: 24px; top: 24px; width: 640px; padding: 32px; padding-top: 24px;
    background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px; border-radius: 0;
    align-items: flex-start;
}
/* Over a match the panel moves to the top-right so it never covers the Killer's bottom-left cluster or its play menu. */
.root.in-game .settings { left: auto; right: 24px; }
.root .settings .title { margin-bottom: 16px; }
.root .set-row { flex-direction: row; align-items: center; height: 48px; margin-bottom: 12px; }
.root .unity-label.set-label { width: 240px; margin: 0; }
.root .unity-label.set-value { width: 80px; margin: 0; margin-left: 16px; -unity-text-align: middle-right; }
.root .unity-label.set-note { color: #9A9890; font-size: 14px; margin-top: 0; margin-bottom: 16px; }
.root.s-floor .unity-label.set-note { font-size: 15px; }
.root .unity-button.set-toggle { min-width: 240px; margin: 0; }
.root .set-actions { flex-direction: row; margin-top: 12px; }
.root .set-actions .unity-button { margin-bottom: 0; }
.root .unity-button.set-open { margin-top: 24px; }
.root .set-slider { width: 240px; height: 48px; margin: 0; padding: 0; }
.root .set-slider .unity-base-slider__input { height: 48px; }
.root .set-slider .unity-base-slider__drag-container { height: 48px; align-items: stretch; justify-content: center; }
.root .set-slider .unity-base-slider__tracker {
    position: absolute; left: 0; right: 0; top: 22px; height: 4px; margin: 0;
    background-color: #9A9890; border-width: 0; border-radius: 0;
}
.root .set-slider .unity-base-slider__dragger {
    position: absolute; top: 12px; width: 12px; height: 24px; margin: 0;
    background-color: #E8E6E1; border-width: 0; border-radius: 0;
}
.root .set-slider .unity-base-slider__dragger-border { display: none; }
.root .set-slider:hover .unity-base-slider__tracker { background-color: #E8E6E1; }
.root .set-slider:focus .unity-base-slider__tracker { background-color: #E8E6E1; }
.root .set-slider:focus .unity-base-slider__dragger { background-color: #FFFFFF; width: 16px; }

/* ---- Survivor play menu (HUD_SPEC 5): the shared PlayMenu in its Row layout, in the prompt row's slot of the 13.1
   stack (it grows upward). 672x152 u, padding 12, panel fill and a 1 u line border (re-snapped in code); skill name M 600,
   effect S, optional S muted line, then Resume / Settings / Leave match as 160x40 u buttons in one row, gap 8
   (3 x 160 + 2 x 8 = 496 <= 648 u). The buttons keep the kbutton states; the row is pinned 12 u above the bottom edge, so it does not move with line 3. */
.root .smenu {
    width: 672px; height: 152px; padding: 12px; flex-shrink: 0;
    background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px; border-radius: 0;
}
.root .unity-label.smenu-note { margin-bottom: 4px; }
.root .smenu-actions { position: absolute; left: 12px; bottom: 12px; flex-direction: row; height: 40px; }
.root .smenu .unity-button.kbutton.smenu-button { width: 160px; min-width: 0; height: 40px; margin: 0; margin-right: 8px; }
.root .smenu .unity-button.kbutton.smenu-button.klast { margin-right: 0; }

/* S3-credits (V10): the menu ScrollView scroller (Credits is the only ScrollView): thin dark tracker, muted dragger, no arrow buttons. */
.root .cr-scroll .unity-scroller--vertical { width: 12px; }
.root .cr-scroll .unity-scroller__low-button, .root .cr-scroll .unity-scroller__high-button { display: none; }
.root .cr-scroll .unity-base-slider__tracker { background-color: #1A1C1F; border-color: #2C2F33; border-width: 1px; border-radius: 0; }
.root .cr-scroll .unity-base-slider__dragger { background-color: #9A9890; border-width: 0; border-radius: 0; width: 8px; margin-left: 1px; }
.root .cr-scroll .unity-base-slider__dragger:hover, .root .cr-scroll .unity-base-slider:focus .unity-base-slider__dragger { background-color: #E8E6E1; }
.root .cr-scroll .unity-scroller--horizontal { display: none; }
.root .cr-scroll .unity-scroller__slider, .root .cr-scroll .unity-scroller--vertical .unity-base-slider { margin-top: 0; margin-bottom: 0; }
